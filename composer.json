{
    "name": "vanqard/passman",
    "description": "Super simple password hash manager for hashing password, to verify password hashes and test for the need to rehash a password. Fully compliant oo wrapper.",
    "keywords": ["password", "hashing", "password hash", "password hashing"],
    "homepage": "https://github.com/vanqard/passman",
    "license": "MIT",
    "authors": [
        {
            "name": "Thunder Raven-Stoker",
            "email": "thunder@vanqard.com",
            "homepage": "http://phpbrilliance.com/book#author"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.40"
    },
    "autoload": {
        "psr-4": {
            "Vanqard\\PassMan\\": "PassMan"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vanqard\\PassMan\\Test\\": "test/Unit"
        }
    },
    "config": {
        "sort-packages": true
    }
}
